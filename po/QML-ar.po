msgstr "تحديد اتجاه الفرضية البديلة لاختبار فيشر الدقيق."

msgctxt "ContingencyTables|"
msgid "Group one ≠ Group two"
msgstr "المجموعة الأولى ≠ المجموعة الثانية"

msgctxt "ContingencyTables|"

msgstr "عرض تطور الاحتمال البعدي."

msgctxt "InformedBinomialTestBayesian|"
msgid "Prior Distribution"
msgstr "التوزيع القبلي"

msgctxt "InformedBinomialTestBayesian|"
msgid "No factor specified"
msgstr "لم يُحدد عامل"

msgctxt "InformedBinomialTestBayesian|"
msgid "Level #"
msgstr "مستوى #"

msgctxt "InformedBinomialTestBayesian|"
msgid "Prior Model Probability"
msgstr "الاحتمال القبلي للنموذج"

msgctxt "InformedBinomialTestBayesian|"
msgid "Model"
msgstr "النموذج"

msgctxt "InformedBinomialTestBayesian|"
msgid "Order Restricted Hypotheses"
msgstr "فرضيات مقيّدة بالترتيب"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Enter each restriction of one hypothesis on a new line,\n"
"e.g., Low <= Mid <= High\n"
"where 'Low'/'Mid'/'High' are the factor level names.\n"
"Click on the 'plus' icon to add more hypotheses. \n"
"Click the information icon for more examples."
msgstr ""
"أدخل كل قيد لفرضية واحدة في سطر جديد،\n"
"مثل Low <= Mid <= High\n"
"حيث 'Low'/'Mid'/'High' أسماء مستويات العامل.\n"
"انقر رمز 'زائد' لإضافة فرضيات أخرى. \n"
"انقر رمز المعلومات لمزيد من الأمثلة."

msgctxt "InformedBinomialTestBayesian|"
msgid "Click to learn more about the syntax for order restrictions."
msgstr "انقر لمعرفة المزيد عن صياغة القيود الترتيبية."

msgctxt "InformedBinomialTestBayesian|"
msgid "Model 1"
msgstr "النموذج 1"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Ctrl + Enter to apply. Click on the blue button above for help on the "
"restriction syntax"
msgstr "Ctrl + Enter للتطبيق. انقر الزر الأزرق أعلاه للمساعدة في صياغة القيود"

msgctxt "InformedBinomialTestBayesian|"
msgid "Advanced"
msgstr "متقدم"

msgctxt "InformedBinomialTestBayesian|"
msgid "Estimation settings"
msgstr "إعدادات التقدير"

msgctxt "InformedBinomialTestBayesian|"
msgid "Burnin (MCMC)"
msgstr "فترة التهيئة (MCMC)"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Number of initial MCMC samples to discard before analysis begins, allowing "
"the chain to stabilize."
msgstr ""
"عدد عينات MCMC الأولية التي تُستبعد قبل بدء التحليل لإتاحة استقرار السلسلة."

msgctxt "InformedBinomialTestBayesian|"
msgid "Iterations (MCMC)"
msgstr "عدد التكرارات (MCMC)"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Total number of MCMC samples used for estimating the posterior after burn-in."
msgstr ""
"العدد الإجمالي لعينات MCMC المستخدمة لتقدير التوزيع البعدي بعد استبعاد عينات "
"التهيئة."

msgctxt "InformedBinomialTestBayesian|"
msgid "Maximum samples (bridgesampling)"
msgstr "الحد الأقصى للعينات (المعاينة الجسرية)"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Max number of samples used to estimate marginal likelihoods for computing "
"Bayes factors."
msgstr ""
"الحد الأقصى لعدد العينات المستخدمة لتقدير الإمكانات الهامشية من أجل حساب عوامل "
"بايز."

msgctxt "InformedBinomialTestBayesian|"
msgid "Sequential analysis"
msgstr "التحليل التتابعي"

msgctxt "InformedBinomialTestBayesian|"
msgid "Number of steps"
msgstr "عدد الخطوات"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Number of data points at which the Bayes factor is updated during sequential "

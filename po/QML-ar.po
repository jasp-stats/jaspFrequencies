msgstr "مخطط التحليل التتابعي"

msgctxt "InformedBinomialTestBayesian|"
msgid ""
"Displays the development of the Bayes factor or posterior probability as the "
"data come in."
msgstr "عرض تطور عامل بايز أو الاحتمال البعدي مع ورود البيانات."

msgctxt "InformedBinomialTestBayesian|"
msgid "Bayes factors"
msgstr "عوامل بايز"

msgctxt "InformedBinomialTestBayesian|"
msgid "Displays the progression of Bayes factor values."
msgstr "عرض تطور قيم عامل بايز."

msgctxt "InformedBinomialTestBayesian|"
msgid "Posterior probability"
msgstr "الاحتمال البعدي"

msgctxt "InformedBinomialTestBayesian|"
